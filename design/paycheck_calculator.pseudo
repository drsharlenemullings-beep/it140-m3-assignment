START paycheck_calculator
# IT 140 Module Three Assignment
# Paycheck Calculator Pseudocode
#
# This pseudocode calculates an employee's weekly paycheck.
# The employee earns $20 per hour for the first 40 hours
# and $30 per hour for each hour above 40.

START paycheck_calculator

    GET hours_worked

    IF hours_worked > 40
        LET overtime_hours = hours_worked - 40
        LET regular_pay = 40 * 20
        LET overtime_pay = overtime_hours * 30
        LET weekly_pay = regular_pay + overtime_pay
    ELSE
        LET weekly_pay = hours_worked * 20
    ENDIF

    PUT weekly_pay
